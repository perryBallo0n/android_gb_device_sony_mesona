on early-init
    export EXTERNAL_STORAGE /mnt/sdcard
    mkdir /mnt/sdcard 0000 system system
    symlink /mnt/sdcard /sdcard

on fs
    mount ext4 /dev/block/mmcblk0p10 /system wait rw
    mount ext4 /dev/block/mmcblk0p10 /system ro remount
    mount ext4 /dev/block/mmcblk0p15 /data wait noatime nosuid nodev noinit_itable
    mount ext4 /dev/block/mmcblk0p11 /cache wait noatime nosuid nodev noinit_itable
    # Start rainbow LED shimmering on chin bar during boot
    start boot_rainbow

on post-fs
    # Permissions for GPU and display
    chown system graphics /dev/kgsl-3d0
    chmod 0666 /dev/kgsl-3d0
    chown system graphics /dev/genlock
    chmod 0666 /dev/genlock
    write /sys/module/msm_fb/parameters/align_buffer 1

on boot
    # Backlight permissions
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    # Touchscreen & keys
    chown system system /sys/class/leds/button-backlight/brightness
    chmod 0664 /sys/class/leds/button-backlight/brightness

    # Notification LED
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/blue/brightness
    chmod 0664 /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/green/brightness
    chmod 0664 /sys/class/leds/blue/brightness

    # FIH LEDs (Front RGB & Bottom bar)
    chown system system /sys/class/led/fih_led/control
    chmod 0666 /sys/class/led/fih_led/control


    # Vibrator (PMIC)
    chown system system /sys/class/vibrator/pmic-vib/control
    chmod 0666 /sys/class/vibrator/pmic-vib/control

    # Audio dev permissions
    chmod 0666 /dev/msm_snd
    chmod 0666 /dev/msm_pcm_out
    chmod 0666 /dev/msm_pcm_in
    chmod 0666 /dev/msm_pcm_ctl
    chmod 0666 /dev/msm_mp3

    # Bluetooth
    chown bluetooth bluetooth /dev/ttyHS0
    chmod 0660 /dev/ttyHS0
    chown bluetooth bluetooth /sys/devices/platform/msm_serial_hs.0/clock
    chmod 0660 /sys/devices/platform/msm_serial_hs.0/clock
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state

    # Wi-Fi
    mkdir /data/system 0775 system system
    mkdir /data/system/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    # USB composition
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 0fce
    write /sys/class/android_usb/android0/idProduct 6176
    write /sys/class/android_usb/android0/functions mass_storage,adb
    write /sys/class/android_usb/android0/enable 1

on property:sys.boot_completed=1
    # Stop boot rainbow and turn off bottom illumination
    stop boot_rainbow
    write /sys/class/led/fih_led/control "1 4 0
1 5 0
1 6 0
" 

service rmt_storage /system/bin/rmt_storage /dev/block/mmcblk0p12 /dev/block/mmcblk0p13 /dev/block/mmcblk0p14
    user root
    class default

service qmuxd /system/bin/qmuxd
    user radio
    group radio audio bluetooth gps
    disabled

service hciattach /system/bin/brcm_patchram_plus --enable_hci --no2bytes --enable_lpm \
    --baudrate 3000000 --patchram /system/etc/firmware/BCM4330B1_002.001.003.0221.0228.hcd \
    /dev/ttyHS0
    user bluetooth
    group bluetooth net_bt_admin
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dwext -c/data/misc/wifi/wpa_supplicant.conf
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -ABKL
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    disabled
    oneshot

service boot_rainbow /system/bin/boot_rainbow
    user root
    group system
    oneshot
