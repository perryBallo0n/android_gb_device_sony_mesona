# mount point    fstype    device                     flags
/boot            emmc      /dev/block/mmcblk0p8
/system          ext4      /dev/block/mmcblk0p10
/data            ext4      /dev/block/mmcblk0p15
/cache           ext4      /dev/block/mmcblk0p11
/sdcard          vfat      /dev/block/mmcblk0p16
/external_sd     vfat      /dev/block/mmcblk1p1       flags=display="Micro SD";storage;wipeingui;removable
